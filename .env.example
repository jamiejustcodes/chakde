# ─── SITE ──────────────────────────────────────────────────────────────────────
# The public URL of your site (no trailing slash)
# Used for SEO metadata, Open Graph, Stripe success/cancel URLs, and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── STRIPE ─────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
#
# TEST keys (sk_test_... / pk_test_...):   safe to use in development
# LIVE keys (sk_live_... / pk_live_...):   use only in production
#
# NEVER commit real keys to version control — only the .env.example template

# Server-side secret key — never expose to the browser
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# Client-side publishable key — safe to expose
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Webhook signing secret
# Dev:  run `stripe listen --print-secret` with the Stripe CLI
# Prod: copy from your Stripe dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
